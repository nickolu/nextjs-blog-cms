# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys

# Required: Your OpenAI API key
VITE_OPENAI_API_KEY=sk-your-api-key-here

# Optional: OpenAI model to use (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
VITE_OPENAI_MODEL=gpt-4o-mini

# Note: The AI autocomplete feature will be disabled if VITE_OPENAI_API_KEY is not set

# Cloudinary Configuration
# Get your cloud name and create an upload preset at: https://cloudinary.com/console

# Optional: Your Cloudinary cloud name
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Optional: Your Cloudinary upload preset
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Setup Instructions:
# 1. Sign up at https://cloudinary.com (free tier works)
# 2. Copy your Cloud Name from the dashboard
# 3. Go to Settings → Upload → Add Upload Preset
# 4. Set Mode: Unsigned, Folder: blog-images (optional)
# 5. Copy the Preset Name and add both values above
# Note: Image upload will require configuration in Settings if these are not set
